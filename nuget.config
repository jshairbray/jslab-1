<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="gitlab" value="https://gitlab.com/api/v4/projects/89251262/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="gitlab">
      <package pattern="JsLab1.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
